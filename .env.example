# Copy to .env and edit before first run:  cp .env.example .env

# ---- App credentials -------------------------------------------------------
OMR_USER=admin
OMR_PASS=changeme
OMR_PORT=8080

# ---- InfluxDB 3 ------------------------------------------------------------
# Token used by both the InfluxDB server and the app client.
INFLUXDB_TOKEN=change-this-influx-token
INFLUXDB_ORG=omr
INFLUXDB_BUCKET=omr_metrics
INFLUXDB_RETENTION=30d
INFLUXDB_PORT=8181

# URL seen from inside the app container (service name = influxdb).
INFLUXDB_URL=http://influxdb:8181
