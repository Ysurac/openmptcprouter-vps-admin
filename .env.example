# Copy to .env and edit before first run:  cp .env.example .env

# ---- App credentials -------------------------------------------------------
OMR_USER=admin
OMR_PASS=changeme
OMR_PORT=8080

# ---- InfluxDB 3 ------------------------------------------------------------
# Admin token used by both the InfluxDB server and the app client.
# Use a long random string (e.g. `openssl rand -hex 32`). InfluxDB only reads
# it on first start: changing it later requires `influxdb3 create token
# --admin --regenerate` or wiping the influxdb-data volume.
INFLUXDB_TOKEN=change-this-influx-token
INFLUXDB_ORG=omr
INFLUXDB_BUCKET=omr_metrics
INFLUXDB_RETENTION=60d
# Optional override; by default the app derives it from INFLUXDB_RETENTION.
#INFLUXDB_RETENTION_DAYS=60
INFLUXDB_PORT=8181
# InfluxDB is published on localhost only; set 0.0.0.0 to expose it publicly.
#INFLUXDB_BIND=127.0.0.1

# URL seen from inside the app container (service name = influxdb).
INFLUXDB_URL=http://influxdb:8181
